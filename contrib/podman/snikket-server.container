[Unit]
Description=Snikket server (Prosody, coturn)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/sudo-ivan/snikket-server:edge
ContainerName=snikket
Network=host
DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
NoNewPrivileges=true
EnvironmentFile=snikket.conf
Volume=snikket_data:/snikket

[Service]
Restart=always

[Install]
WantedBy=default.target
