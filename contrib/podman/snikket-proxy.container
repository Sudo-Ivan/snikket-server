[Unit]
Description=Snikket web proxy (nginx)
After=snikket-server.service
Before=snikket-certs.service snikket-portal.service

[Container]
Image=ghcr.io/sudo-ivan/snikket-web-proxy:edge
ContainerName=snikket-proxy
Network=host
User=65532
Group=65532
ReadOnly=true
ReadOnlyTmpfs=true
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Relative paths resolve against this unit file's directory.
# Place snikket.conf alongside these units or use an absolute path.
EnvironmentFile=snikket.conf
Volume=snikket_data:/snikket:ro
Volume=acme_challenges:/var/www/html/.well-known/acme-challenge:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
