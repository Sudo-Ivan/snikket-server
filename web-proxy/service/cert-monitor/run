#!/bin/bash

export SNIKKET_DOMAIN_ASCII=$(idn2 "$SNIKKET_DOMAIN")

CERT_PATH="/snikket/letsencrypt/live/$SNIKKET_DOMAIN_ASCII/fullchain.pem"

PROTOS="${SNIKKET_TWEAK_WEB_PROXY_PROTOS:-http https}"

while sleep 10; do
	if test -f "$CERT_PATH"; then
		if test -f /tmp/nginx/sites-enabled/startup; then
			rm /tmp/nginx/sites-enabled/startup;
		fi
		/usr/local/bin/render-template.sh "/etc/nginx/templates/snikket-common" "/tmp/nginx/snippets/snikket-common.conf"
		for proto in $PROTOS; do
			/usr/local/bin/render-template.sh "/etc/nginx/templates/$proto" "/tmp/nginx/sites-enabled/$proto";
		done
		/usr/bin/nginx -e /dev/stderr -s reload
		break;
	elif test -f "/snikket/letsencrypt/has-errors"; then
		sed -i 's/div\.cert-status-info-problem/div.cert-status-info-pending/' /tmp/www/index.html
	else
		sed -i 's/div\.cert-status-info-pending/div.cert-status-info-problem/' /tmp/www/index.html
	fi
done

# Reload nginx daily to pick up new certificates
while sleep "${SNIKKET_TWEAK_WEB_PROXY_RELOAD_INTERVAL:-86400}"; do
	/usr/bin/nginx -e /dev/stderr -s reload;
done
